# ==============================================================================
# Scribe Repository Allow-list
# ==============================================================================

# Exclude everything by default
*

# Allow directories but don't track contents by default
!*/

# --- Root Configuration Files ---
!.gitignore
!.npmrc
!.github/
!LICENSE
!PROGRESS.md
!README.md
!SCRIBE_SPEC.md
!antora-playbook.yml
!dprint.jsonc
!index.html
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!postcss.config.js
!scribe.code-workspace
!tailwind.config.js
!tsconfig.json
!vite.config.ts

# --- Source & Asset Directories ---
!electron/**
!profiles/**
!src/**
!docs/**
!site/**

# --- Nested Directory Exclusions ---
# site/ is a sub-project with its own build artifacts
site/node_modules/
site/dist/

# --- Always Excluded ---
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.log
**/*.local
**/node_modules/
**/dist/
**/dist-electron/
**/dist-package/
**/.cache/
**/.temp/

!/.github/
!/.github/workflows/
!/.github/workflows/encoding-guard.yml
!/.editorconfig
!/.gitattributes
