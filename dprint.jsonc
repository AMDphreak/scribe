{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 4,
  "excludes": [
    "**/bin/**",
    "**/.dub/**",
    "**/dub.selections.json",
    "**/*.lock"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/markdown-0.16.3.wasm"
  ],
  "json": {
    "indentWidth": 2
  },
  "markdown": {
    "lineWidth": 100
  }
}
