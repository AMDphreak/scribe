name "scribe"
description "A user-friendly writing environment for static site content. Supports GitHub, GitLab, and custom VCS profiles via SDLang."
homepage "https://github.com/amdphreak/scribe"
license "AGPL-3.0-or-later"
authors "AMDphreak"

targetPath "bin"
targetType "executable"
targetName "scribe"

sourcePaths "source"

dependency "dlangui" version="~>0.9.82"
dependency "sdlang-d" version="~>0.10.6"

configuration "default" {
}

configuration "console" {
	subConfiguration "dlangui" "console"
}

configuration "sdl" {
	subConfiguration "dlangui" "sdl"
}
